# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# Supabase Platform project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Site URL — used for auth redirects (password reset, email confirmation)
# localhost in dev, real domain in prod
NEXT_PUBLIC_SITE_URL=

# n8n webhook auth — must match the Header Auth credential configured in n8n exactly
# N8N_WEBHOOK_SECRET_HEADER is the header name (e.g. X-Webhook-Secret)
# N8N_WEBHOOK_SECRET is the header value
N8N_WEBHOOK_SECRET_HEADER=
N8N_WEBHOOK_SECRET=
